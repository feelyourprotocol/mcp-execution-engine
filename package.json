{
  "name": "@feelyourprotocol/mcp-execution-engine",
  "version": "0.1.0",
  "description": "Stateless deterministic future-Ethereum-protocol simulation engine for MCP",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.eslint.json --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "lf": "npm run format && npm run lint",
    "lf:ci": "eslint . && prettier -c src/",
    "lab": "tsx scripts/lab.mts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ethereumjs/common": "^10.1.2",
    "@ethereumjs/evm": "^10.1.2",
    "@ethereumjs/util": "^10.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.16.5",
    "@vitest/eslint-plugin": "^1.3.4",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jiti": "^2.4.2",
    "prettier": "3.6.2",
    "tsx": "^4.20.3",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
