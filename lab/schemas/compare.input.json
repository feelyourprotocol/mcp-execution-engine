{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feelyourprotocol.org/schemas/mcp-engine/compare.input.json",
  "title": "CompareVariantsInput",
  "type": "object",
  "required": ["variants"],
  "properties": {
    "variants": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["label", "bytecode", "fork"],
        "properties": {
          "label": { "type": "string" },
          "bytecode": { "type": "string" },
          "fork": {
            "type": "object",
            "properties": {
              "baseHardfork": { "type": "string" },
              "eips": { "type": "array", "items": { "type": "integer" } }
            },
            "required": ["baseHardfork"]
          },
          "gasLimit": { "type": "string" },
          "trace": { "type": "boolean" }
        }
      }
    }
  },
  "additionalProperties": false
}
