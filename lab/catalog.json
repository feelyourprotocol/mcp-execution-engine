{
  "engineVersion": "0.1.0",
  "mcpDocs": "https://mcp-docs.feelyourprotocol.org",
  "shapes": [
    {
      "id": "simulate",
      "status": "shipped",
      "engineFn": "simulateBytecode",
      "mcpTool": "run_bytecode",
      "transport": { "stdio": "live", "http": "planned-step-5" },
      "summary": "Run raw bytecode under a fork / EIP configuration; optional execution trace."
    },
    {
      "id": "transaction",
      "status": "shipped",
      "engineFn": "runTransaction",
      "mcpTool": "run_transaction",
      "transport": { "stdio": "live", "http": "planned-step-5" },
      "summary": "Run a value-bearing transaction (paid gas, receipt logs, EIP-8037 dimensions)."
    },
    {
      "id": "block",
      "status": "shipped",
      "engineFn": "runBlock",
      "mcpTool": "run_block",
      "transport": { "stdio": "live", "http": "planned-step-5" },
      "summary": "Run 1–8 impersonated txs as a lab block; optional header slot/number/timestamp."
    },
    {
      "id": "probe",
      "status": "shipped",
      "engineFn": "describeCapabilities",
      "mcpTool": "describe_capabilities",
      "transport": { "stdio": "live", "http": "planned-step-5" },
      "summary": "Describe supported forks, runnable EIP modules, opcodes, and encoding."
    },
    {
      "id": "generate",
      "status": "planned",
      "engineFn": "generateBal",
      "mcpTool": "generate_eip7928_bal",
      "transport": { "stdio": "planned-step-6", "http": "planned-step-6" },
      "summary": "Produce structured outputs such as block-level access lists (EIP-7928)."
    }
  ],
  "examples": [
    {
      "id": "simulate/01-push1-stop",
      "shape": "simulate",
      "title": "PUSH1 STOP on Amsterdam",
      "input": "shapes/simulate/examples/01-push1-stop/input.json",
      "notes": "shapes/simulate/examples/01-push1-stop/notes.md"
    },
    {
      "id": "simulate/02-dupn-amsterdam",
      "shape": "simulate",
      "title": "EIP-8024 DUPN stack demo on Amsterdam",
      "input": "shapes/simulate/examples/02-dupn-amsterdam/input.json",
      "notes": "shapes/simulate/examples/02-dupn-amsterdam/notes.md"
    },
    {
      "id": "transaction/01-first-touch",
      "shape": "transaction",
      "title": "First-touch 1 wei transfer on Amsterdam",
      "input": "shapes/transaction/examples/01-first-touch/input.json",
      "notes": "shapes/transaction/examples/01-first-touch/notes.md"
    },
    {
      "id": "block/01-first-touch",
      "shape": "block",
      "title": "First-touch 1 wei transfer as a lab block",
      "input": "shapes/block/examples/01-first-touch/input.json",
      "notes": "shapes/block/examples/01-first-touch/notes.md"
    },
    {
      "id": "block/02-slot-header",
      "shape": "block",
      "title": "Amsterdam header slot 42 via SLOTNUM",
      "input": "shapes/block/examples/02-slot-header/input.json",
      "notes": "shapes/block/examples/02-slot-header/notes.md"
    },
    {
      "id": "probe/01-capabilities",
      "shape": "probe",
      "title": "Full capability registry snapshot",
      "input": null,
      "notes": "shapes/probe/examples/01-capabilities/notes.md"
    }
  ]
}
